# Copy to .env and fill in. Never commit .env.

# --- Storage -----------------------------------------------------------------
# duckdb (default, no infrastructure) or postgres
VULNINTEL_DB_BACKEND=duckdb
VULNINTEL_DUCKDB_PATH=data/warehouse/vulnintel.duckdb
# Used only when VULNINTEL_DB_BACKEND=postgres
VULNINTEL_POSTGRES_DSN=postgresql://vulnintel:vulnintel@localhost:5432/vulnintel
VULNINTEL_BRONZE_ROOT=data/bronze

# --- LLM ---------------------------------------------------------------------
# anthropic | mock   (mock runs the whole graph offline, deterministically)
VULNINTEL_LLM_PROVIDER=anthropic
VULNINTEL_LLM_MODEL=claude-opus-5
VULNINTEL_LLM_EFFORT=medium
VULNINTEL_LLM_MAX_TOKENS=16000
ANTHROPIC_API_KEY=

# --- Embeddings --------------------------------------------------------------
# hash (offline, deterministic) | sentence-transformers
VULNINTEL_EMBEDDING_PROVIDER=hash
VULNINTEL_EMBEDDING_DIM=384
VULNINTEL_SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Feed credentials --------------------------------------------------------
# Free key from https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD allows ~5 requests / 30s; with it ~50 / 30s.
NVD_API_KEY=
# Optional, raises GitHub Advisory rate limits from 60/hr to 5000/hr
GITHUB_TOKEN=

# --- Behaviour ---------------------------------------------------------------
VULNINTEL_MAX_REPLANS=2
VULNINTEL_SYNTHETIC_SEED=20260904
VULNINTEL_LOG_LEVEL=INFO
