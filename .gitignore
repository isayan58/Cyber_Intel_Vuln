# Secrets
.env

# Generated documents (regenerated from scripts/, never committed)
*.docx
~$*.docx
docs/generated/

# macOS AppleDouble sidecars. exFAT/FAT volumes cannot store extended
# attributes, so macOS writes a binary ._name beside every file. They are
# not matched by a rule for the file itself — ._.env slipped past a .env
# rule and was staged before this was added.
._*
.AppleDouble/
.Spotlight-V100
.Trashes

# Local artefacts
.DS_Store
apps/api/static/vendor/
